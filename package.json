{
  "name": "ssf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "data:wilayah": "node scripts/build_wilayah_index.mjs",
    "data:lp": "python3 scripts/build_lp_grid.py --stub",
    "preview:cf": "pnpm build && wrangler pages dev dist",
    "deploy": "pnpm build && wrangler pages deploy dist"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "maplibre-gl": "^5.9.0",
    "vue": "^3.5.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.118.0"
  }
}
